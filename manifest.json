{
  "manifest_version": 3,
  "name": "Penpal",
  "version": "0.1.0",
  "description": "Your AI writing companion for Gmail",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}